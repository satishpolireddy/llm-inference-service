# ── Inference backend ─────────────────────────────────────────────────────────
# Backend to use: "hf" (HuggingFace Transformers) or "vllm" (vLLM)
BACKEND=hf

# HuggingFace model ID or path to local weights
MODEL_NAME=meta-llama/Llama-3.2-1B-Instruct

# ── Semantic cache ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# Cosine similarity threshold for a cache hit (0.0–1.0)
CACHE_SIMILARITY_THRESHOLD=0.92

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Sentence-transformers model for embedding cache keys
EMBED_MODEL=all-MiniLM-L6-v2

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Set to avoid repeated downloads
HF_HOME=/tmp/huggingface
# HF_TOKEN=hf_...   # Required for gated models (Llama, Mistral, etc.)
